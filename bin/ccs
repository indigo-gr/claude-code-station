#!/usr/bin/env bash
# ccs - Claude Code Station: fzf-powered launcher (NEW repos + RESUME sessions)
# https://github.com/indigo-gr/claude-code-station

set -euo pipefail
# bash 5 turns checkwinsize on by default, also in scripts: after any program
# run in the foreground it resets COLUMNS to the terminal's width, so an
# exported COLUMNS would lose to the real width (see terminal_cols).
shopt -u checkwinsize

# Resolve $0 through symlinks before taking dirname: `npm install -g
# github:indigo-gr/claude-code-station` links this script into the global
# bin dir, and the SYMLINK's dirname has none of the sibling .ts modules.
SOURCE="$0"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  if [[ "$SOURCE" != /* ]]; then SOURCE="${DIR}/${SOURCE}"; fi
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Single source of truth: read version from package.json next to bin/.
# Falls back to "0.0.0-dev" for copy-install layouts (install.sh drops bin/
# scripts into ~/.claude/scripts/ without package.json) or if the read fails.
# Only this package's own file counts: install.sh copies into ~/.claude/scripts/,
# where ../package.json can belong to something else entirely, and its version
# must not reach the screen or the update check. A bash match, no extra process.
CCS_PACKAGE='@indigo-gr/claude-code-station'
CCS_INSTALL_CMD="npm install -g ${CCS_PACKAGE}"
VERSION="0.0.0-dev"
read_package_version() {
  local file="${SCRIPT_DIR}/../package.json" json=""
  local name_re='"name"[[:space:]]*:[[:space:]]*"([^"]*)"'
  local version_re='"version"[[:space:]]*:[[:space:]]*"([0-9A-Za-z.+-]+)"'
  [[ -f "$file" && -r "$file" ]] || return 0
  json=$(<"$file") || return 0
  [[ "$json" =~ $name_re ]] || return 0
  [[ "${BASH_REMATCH[1]}" == "$CCS_PACKAGE" ]] || return 0
  [[ "$json" =~ $version_re ]] || return 0
  VERSION="${BASH_REMATCH[1]}"
}
read_package_version 2>/dev/null || true

# Prefer a package-local tsx over the PATH one: the npm install brings tsx
# as a dependency (../node_modules from the package's bin/), and the copy
# install (install.sh) symlinks node_modules next to the scripts. Fall back
# to a globally installed tsx for the bare-checkout workflow.
if [[ -x "${SCRIPT_DIR}/../node_modules/.bin/tsx" ]]; then
  TSX="${SCRIPT_DIR}/../node_modules/.bin/tsx"
elif [[ -x "${SCRIPT_DIR}/node_modules/.bin/tsx" ]]; then
  TSX="${SCRIPT_DIR}/node_modules/.bin/tsx"
else
  TSX="tsx"
fi

# Every module starts through ccs-tsx.sh, from ccs's own folder: Node reads
# the package.json above the CURRENT folder for tsx's preload, and a broken
# one there would stop every module (the user's folder goes on in CCS_CWD).
# TSX stays the tsx to check for; TSX_RUN is how a module is started.
export CCS_TSX_REAL="$TSX"
CCS_TSX_SH="${SCRIPT_DIR}/ccs-tsx.sh"
TSX_RUN=(bash "$CCS_TSX_SH")

CCS_LIST="${SCRIPT_DIR}/ccs-list.ts"
CCS_SCAN="${SCRIPT_DIR}/ccs-scan.ts"
CCS_PREVIEW="${SCRIPT_DIR}/ccs-preview.ts"
CCS_DELETE="${SCRIPT_DIR}/ccs-delete.sh"
CCS_INIT="${SCRIPT_DIR}/ccs-init.ts"
CCS_UPDATE="${SCRIPT_DIR}/ccs-update-check.ts"
COPYRIGHT='Copyright © INDIGO GROUP LLC.'

# ── CCR_CMD -> CCS_CMD migration shim ────────────────────────────────────────
if [[ -n "${CCR_CMD:-}" && -z "${CCS_CMD:-}" ]]; then
  echo "[ccs] CCR_CMD is deprecated, please rename to CCS_CMD (using CCR_CMD value for now)" >&2
  export CCS_CMD="${CCR_CMD}"
fi

# ── Machine interface: doctor, list, sessions, repo, config, open ────────────
# Words for GUI launchers, scripts and other tools (docs/design/
# machine-interface.md). Only as the FIRST argument: `ccs --new doctor` still
# passes `doctor` on to the launched command. Handled before the dependency
# check and the update check: these commands never open fzf, read stdin, go
# to the network or create the config template or the cache. Exit codes and
# the JSON shape are the contract; stderr is for people and never carries a
# repo path or name.
CCS_MACHINE="${SCRIPT_DIR}/ccs-machine.ts"
CCS_DOCTOR="${SCRIPT_DIR}/ccs-doctor.ts"
NODE_MIN_MAJOR=22      # package.json engines.node
FZF_MIN=(0 42)         # README and install.sh
FZF_HEADERS_MIN=(0 45) # fzf's transform action (group headers stay open)
CHECK_TIMEOUT=5        # node --version, fzf --version
DOCTOR_STAGE2_TIMEOUT=20

# The values a hand-built answer may carry: words, a version, a time.
json_version() { # json_version VALUE → "VALUE" or null
  if [[ "$1" =~ ^[0-9A-Za-z.+-]{1,32}$ ]]; then printf '"%s"' "$1"; else printf 'null'; fi
}
utc_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# The outer object (machine-interface.md 1.3), for the cases where no .ts
# module can answer. Words only, so printf is enough.
machine_outer() { # machine_outer COMMAND STATUS
  printf '"schema_version":"1.0.0","product_id":"ccs","product_version":%s,"command":"%s","written_at":"%s","status":"%s"' \
    "$(json_version "$VERSION")" "$1" "$(utc_now)" "$2"
}
machine_fail() { # machine_fail COMMAND JSON(0|1) STATUS EXIT CODE [DETAIL] [NOTE]
  local detail=""
  [[ -z "${6:-}" ]] || detail=",\"detail\":\"$6\""
  if [[ "$2" == 1 ]]; then
    printf '{%s,"reasons":[{"vocab":"ccs.cli","code":"%s"%s}]}\n' "$(machine_outer "$1" "$3")" "$5" "$detail"
  fi
  echo "[ccs] ${1}: ${3}: ${5}${6:+ (${6})}${7:+ — ${7}}" >&2
  exit "$4"
}
args_want_json() { # args_want_json ARGS... — `--json` before a bare `--`
  local a
  for a in "$@"; do
    [[ "$a" == "--" ]] && return 1
    [[ "$a" == "--json" ]] && return 0
  done
  return 1
}

# run_timed SECONDS OUT ERR CMD... — run CMD with stdin from /dev/null, its
# output in the two files, for at most SECONDS. Sets TIMED_RC and TIMED_OUT.
# A polling loop, not timeout(1): macOS has none, and a background `sleep`
# would outlive the command.
# While it runs, this shell's own stderr goes to /dev/null: bash reports a job
# it had to kill ("<script path>: line N: PID Terminated …"), and that line
# names the install path. The command's stderr goes to ERR either way.
run_timed() {
  local limit=$1 out=$2 err=$3 pid ticks=0
  shift 3
  TIMED_OUT=0 TIMED_RC=0
  exec 3>&2 2>/dev/null
  "$@" >"$out" 2>"$err" </dev/null &
  pid=$!
  MACHINE_CHILD=$pid
  while kill -0 "$pid" 2>/dev/null; do
    if (( ticks >= limit * 10 )); then
      kill -TERM "$pid" 2>/dev/null || true
      sleep 0.2
      kill -KILL "$pid" 2>/dev/null || true
      TIMED_OUT=1
      break
    fi
    sleep 0.1
    ticks=$((ticks + 1))
  done
  wait "$pid" 2>/dev/null || TIMED_RC=$?
  exec 2>&3 3>&-
  MACHINE_CHILD=""
}

# machine_tmp_dir NAME — a fresh 0700 folder for this run in TMPDIR, or in
# /tmp when TMPDIR is missing or not writable. Sets MACHINE_TMP and
# MACHINE_TMP_BASE (the folder it was made in). The .ts modules run with
# TMPDIR set to MACHINE_TMP, so what tsx puts in its temporary folder goes
# when the folder is removed at exit.
machine_tmp_dir() {
  local base
  for base in "${TMPDIR:-/tmp}" /tmp; do
    base="${base%/}"
    [[ -n "$base" ]] || continue
    if MACHINE_TMP=$(mktemp -d "${base}/$1.XXXXXX" 2>/dev/null); then
      MACHINE_TMP_BASE="$base"
      return 0
    fi
  done
  return 1
}

version_at_least() { # version_at_least X.Y MAJOR MINOR
  [[ "$1" =~ ^([0-9]+)\.([0-9]+) ]] || return 1
  local maj=$((10#${BASH_REMATCH[1]})) min=$((10#${BASH_REMATCH[2]}))
  (( maj > $2 || (maj == $2 && min >= $3) ))
}

# Node prints these when it cannot load a module at all (doctor's `modules`).
stage2_load_error() { # stage2_load_error STDERR_FILE → word on stdout
  if grep -Eq 'Invalid package config|ERR_INVALID_PACKAGE_CONFIG' "$1" 2>/dev/null; then
    echo invalid_package_config
  elif grep -Eq 'ERR_MODULE_NOT_FOUND|Cannot find module|ERR_UNKNOWN_FILE_EXTENSION|ERR_REQUIRE_ESM|SyntaxError' "$1" 2>/dev/null; then
    echo module_load_failed
  fi
}

# ── ccs doctor [--json] ──
# Stage 1 (here, in bash): what must hold before any .ts module can load.
# Stage 2 (ccs-doctor.ts): the modules, better-sqlite3, repos.yml, the cache;
# it prints the whole answer. If stage 2 gives none, the answer is built here
# from stage 1. Exit 0 works, 1 does not, 2 bad arguments, 3 cannot tell.
run_doctor() {
  local bad=0 a
  DOCTOR_JSON=0
  for a in "$@"; do
    case "$a" in
      --json) DOCTOR_JSON=1 ;;
      *) bad=1 ;;
    esac
  done
  if (( bad )); then
    if (( DOCTOR_JSON )); then
      printf '{%s,"installed":"installed","running":"not_applicable","reasons":[{"vocab":"ccs.cli","code":"unknown_option"}]}\n' \
        "$(machine_outer doctor usage)"
    fi
    echo "[ccs] doctor takes only --json (usage: unknown_option)" >&2
    exit 2
  fi

  if ! machine_tmp_dir ccs-doctor; then
    if (( DOCTOR_JSON )); then
      printf '{%s,"installed":"installed","running":"not_applicable","reasons":[{"vocab":"ccs.cli","code":"internal_error"}]}\n' \
        "$(machine_outer doctor failed)"
    fi
    echo "[ccs] doctor: failed: internal_error — cannot create a temporary folder (TMPDIR or /tmp)" >&2
    exit 1
  fi
  DOCTOR_TMP="$MACHINE_TMP"
  MACHINE_CHILD=""
  trap 'rm -rf "$DOCTOR_TMP"' EXIT
  trap 'doctor_interrupted' INT
  doctor_interrupted() {
    [[ -z "$MACHINE_CHILD" ]] || kill -TERM "$MACHINE_CHILD" 2>/dev/null || true
    if (( DOCTOR_JSON )); then
      printf '{%s,"installed":"installed","running":"not_applicable","reasons":[{"vocab":"ccs.cli","code":"interrupted"}]}\n' \
        "$(machine_outer doctor interrupted)"
    fi
    exit 130
  }
  local out="$DOCTOR_TMP/out" err="$DOCTOR_TMP/err" v

  # node: present, and at least engines.node.
  local c_node c_tsx c_fzf c_claude c_modules
  if ! command -v node >/dev/null 2>&1; then
    c_node="fail:node_missing"
  else
    run_timed "$CHECK_TIMEOUT" "$out" "$err" node --version
    v=$(head -n 1 "$out" 2>/dev/null || true)
    if (( TIMED_OUT )); then
      c_node="unknown:check_timeout"
    elif (( TIMED_RC == 0 )) && [[ "$v" =~ ^v([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
      v="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.${BASH_REMATCH[3]}"
      if (( 10#${BASH_REMATCH[1]} < NODE_MIN_MAJOR )); then
        c_node="fail:node_too_old:$v"
      else
        c_node="ok:ok:$v"
      fi
    else
      c_node="unknown:check_crashed"
    fi
  fi

  # tsx: the package's own, or one on PATH.
  if [[ "$TSX" == "tsx" ]] && ! command -v tsx >/dev/null 2>&1; then
    c_tsx="fail:tsx_missing"
  else
    c_tsx="ok:ok"
  fi

  # fzf: present and at least 0.42.0; under 0.45 group headers do not stay open.
  if ! command -v fzf >/dev/null 2>&1; then
    c_fzf="fail:fzf_missing"
  else
    run_timed "$CHECK_TIMEOUT" "$out" "$err" fzf --version
    v=$(head -n 1 "$out" 2>/dev/null || true)
    if (( TIMED_OUT )); then
      c_fzf="unknown:check_timeout"
    elif (( TIMED_RC == 0 )) && [[ "$v" =~ ^([0-9]+\.[0-9]+(\.[0-9]+)?) ]]; then
      v="${BASH_REMATCH[1]}"
      if ! version_at_least "$v" "${FZF_MIN[@]}"; then
        c_fzf="fail:fzf_too_old:$v"
      elif ! version_at_least "$v" "${FZF_HEADERS_MIN[@]}"; then
        c_fzf="warn:fzf_too_old_for_headers:$v"
      else
        c_fzf="ok:ok:$v"
      fi
    else
      c_fzf="unknown:check_crashed"
    fi
  fi

  # claude: on PATH (never started).
  if command -v claude >/dev/null 2>&1; then c_claude="ok:ok"; else c_claude="fail:claude_missing"; fi

  # Stage 2, when Node and tsx can run it.
  if [[ "$c_node" == ok:* && "$c_tsx" == ok:* ]]; then
    local limit="$DOCTOR_STAGE2_TIMEOUT"
    [[ "${CCS_DOCTOR_TIMEOUT:-}" =~ ^[1-9][0-9]{0,2}$ ]] && limit="$CCS_DOCTOR_TIMEOUT"
    local mode=()
    (( DOCTOR_JSON )) && mode=(--json)
    run_timed "$limit" "$out" "$err" env TMPDIR="$DOCTOR_TMP" TSX_DISABLE_CACHE=1 \
      "${TSX_RUN[@]}" "$CCS_DOCTOR" ${mode[@]+"${mode[@]}"} \
      --node "$c_node" --tsx "$c_tsx" --fzf "$c_fzf" --claude "$c_claude"
    if (( TIMED_OUT )); then
      c_modules="unknown:check_timeout"
    elif [[ "$TIMED_RC" =~ ^[013]$ && -s "$out" ]] && { (( ! DOCTOR_JSON )) || [[ "$(head -c 1 "$out")" == "{" ]]; }; then
      cat "$out"
      exit "$TIMED_RC"
    else
      v=$(stage2_load_error "$err")
      if [[ -n "$v" ]]; then c_modules="fail:$v"; else c_modules="unknown:check_crashed"; fi
    fi
  else
    c_modules="skipped:blocked"
  fi

  doctor_answer_from_stage1 "$DOCTOR_JSON" "$c_node" "$c_tsx" "$c_modules" "$c_fzf" "$c_claude"
}

# The answer without stage 2: stage 1's checks, `modules` as found, the rest
# skipped (blocked). Same rules as ccs-doctor.ts's decide().
doctor_answer_from_stage1() { # JSON NODE TSX MODULES FZF CLAUDE
  local json=$1
  shift
  local names=(node tsx modules sqlite fzf claude config config_layout cache terminal groups_dir)
  local values=("$1" "$2" "$3" "skipped:blocked" "$4" "$5" "skipped:blocked" "skipped:blocked" "skipped:blocked" "skipped:blocked" "skipped:blocked")
  local required=" node tsx modules sqlite fzf claude config "
  local i st code ver v checks="" fails="" unknowns="" rows=""
  for i in "${!names[@]}"; do
    IFS=: read -r st code ver <<< "${values[$i]}"
    [[ -n "$checks" ]] && checks+=","
    checks+="{\"name\":\"${names[$i]}\",\"status\":\"${st}\",\"code\":\"${code}\""
    [[ -n "$ver" ]] && checks+=",\"version\":$(json_version "$ver")"
    checks+="}"
    if [[ "$required" == *" ${names[$i]} "* ]]; then
      [[ "$st" == fail ]] && fails+="${fails:+,}{\"vocab\":\"ccs.health\",\"code\":\"${code}\"}"
      [[ "$st" == unknown ]] && unknowns+="${unknowns:+,}{\"vocab\":\"ccs.health\",\"code\":\"${code}\"}"
    fi
    v="$(printf '%-14s%-9s%s' "${names[$i]}" "$st" "$([[ "$code" == ok ]] || echo "$code")")${ver:+  version=$ver}"
    rows+="  ${v%"${v##*[! ]}"}"$'\n'
  done
  local status rc reasons
  if [[ -n "$fails" ]]; then
    status=failed rc=1 reasons="$fails"
  elif [[ -n "$unknowns" ]]; then
    status=unverifiable rc=3 reasons="$unknowns"
  else
    status=ok rc=0 reasons='{"vocab":"ccs.health","code":"ok"}'
  fi
  local os arch
  os=$(uname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')
  arch=$(uname -m 2>/dev/null)
  case "$arch" in
    x86_64|amd64) arch=x64 ;;
    aarch64) arch=arm64 ;;
  esac
  [[ "$os" =~ ^[a-z0-9_]{1,32}$ ]] || os=unknown
  [[ "$arch" =~ ^[a-z0-9_]{1,32}$ ]] || arch=unknown
  if [[ "$json" == 1 ]]; then
    printf '{%s,"installed":"installed","running":"not_applicable","reasons":[%s],"checks":[%s],"platform":{"os":"%s","arch":"%s"}}\n' \
      "$(machine_outer doctor "$status")" "$reasons" "$checks" "$os" "$arch"
  else
    case "$status" in
      ok) echo "ccs doctor: ccs works (ok)" ;;
      failed) echo "ccs doctor: ccs does not work (failed)" ;;
      *) echo "ccs doctor: could not tell (${status})" ;;
    esac
    printf '%s' "$rows"
  fi
  exit "$rc"
}

# ── ccs list | sessions | repo | config | open ──
# One .ts entry (ccs-machine.ts) answers all of them. Its stdout is passed on
# as is; when it gives nothing (Node cannot load the modules), the answer is
# built here. stderr is held so Node's own dump (it names files) stays out.
run_machine() {
  local word=$1
  # `command` names the subcommand too (repo add, config get), known words only.
  case "${1}:${2:-}" in
    repo:add|repo:remove|config:get|config:set) word="$1 $2" ;;
  esac
  MACHINE_JSON=0
  args_want_json "${@:2}" && MACHINE_JSON=1
  if ! command -v node >/dev/null 2>&1; then
    machine_fail "$word" "$MACHINE_JSON" missing_prerequisite 4 dependency_missing node
  fi
  if [[ "$TSX" == "tsx" ]] && ! command -v tsx >/dev/null 2>&1; then
    machine_fail "$word" "$MACHINE_JSON" missing_prerequisite 4 dependency_missing tsx
  fi
  machine_tmp_dir ccs-machine ||
    machine_fail "$word" "$MACHINE_JSON" failed 1 internal_error "" "cannot create a temporary folder (TMPDIR or /tmp)"
  trap 'rm -rf "$MACHINE_TMP"' EXIT
  MACHINE_ERR="$MACHINE_TMP/err"
  # The child gets SIGINT too and answers it itself (130 and the outer object).
  local rc=0 out="" got_int=0 load_error
  trap 'got_int=1' INT
  out=$(TMPDIR="$MACHINE_TMP" TSX_DISABLE_CACHE=1 "${TSX_RUN[@]}" "${CCS_MACHINE}" "$@" 2>"$MACHINE_ERR" </dev/null) || rc=$?
  trap - INT
  load_error=$(stage2_load_error "$MACHINE_ERR")
  # The module answered: JSON on stdout, or (without --json) its own line.
  if [[ -n "$out" ]] || { (( ! MACHINE_JSON )) && [[ -z "$load_error" ]] && (( ! got_int )); }; then
    [[ -z "$out" ]] || printf '%s\n' "$out"
    cat "$MACHINE_ERR" >&2
    exit "$rc"
  fi
  if (( got_int )); then
    machine_fail "$word" "$MACHINE_JSON" interrupted 130 interrupted
  fi
  if [[ "$load_error" == invalid_package_config ]]; then
    machine_fail "$word" "$MACHINE_JSON" failed 1 invalid_package_config "" \
      "a package.json above ccs cannot be parsed, so Node will not load ccs's modules; fix or remove that file"
  fi
  machine_fail "$word" "$MACHINE_JSON" failed 1 internal_error "" "${load_error:-no answer from the module}"
}

# ── Starting the launch command (the list and `ccs open --here`) ──
# command_is_safe CMD — the defense-in-depth copy of the policy ccs-config.ts
# enforces on `command` at load time (shell metacharacters, control chars).
command_is_safe() {
  [[ ! "$1" =~ [\;\&\|\<\>\$\`\"\'\\] && ! "$1" =~ [[:cntrl:]] ]]
}
# run_launch_command KIND KEY CMD [ARGS...] — run CMD in the current folder:
# `new` as is, `resume` with --resume KEY. Direct invocation (NOT exec) so
# shell functions / aliases like `opr` work; CMD is split into words with no
# wildcard expansion.
run_launch_command() {
  local kind=$1 key=$2 cmd=$3
  shift 3
  set -f
  # shellcheck disable=SC2086
  if [[ "$kind" == resume ]]; then
    ${cmd} --resume "$key" "$@"
  else
    ${cmd} "$@"
  fi
  set +f
}

# ── ccs open (--repo NAME | --session UUID) [--here | --new-window] … ──
# ccs-open.ts decides (every check of the list, without its fallbacks); for
# --here it leaves the plan in a file and this shell starts the command in
# this terminal, after checking the plan once more. --new-window is done
# entirely by the module (it hands a one-shot .command file to the app).
run_open() {
  MACHINE_JSON=0
  args_want_json "$@" && MACHINE_JSON=1
  if ! command -v node >/dev/null 2>&1; then
    machine_fail open "$MACHINE_JSON" missing_prerequisite 4 dependency_missing node
  fi
  if [[ "$TSX" == "tsx" ]] && ! command -v tsx >/dev/null 2>&1; then
    machine_fail open "$MACHINE_JSON" missing_prerequisite 4 dependency_missing tsx
  fi
  machine_tmp_dir ccs-open-plan ||
    machine_fail open "$MACHINE_JSON" failed 1 internal_error "" "cannot create a temporary folder (TMPDIR or /tmp)"
  OPEN_TMP="$MACHINE_TMP"
  trap 'rm -rf "$OPEN_TMP"' EXIT
  local tty=0 rc=0 out="" got_int=0 load_error a seen=0
  [[ -t 0 && -t 1 ]] && tty=1
  # Arguments after a bare `--` go to the launched command.
  local pass=()
  for a in "$@"; do
    if (( seen )); then pass+=("$a"); elif [[ "$a" == "--" ]]; then seen=1; fi
  done
  trap 'got_int=1' INT
  # The launcher file of --new-window must outlive this run: it goes to the
  # folder OPEN_TMP was made in, not into OPEN_TMP (removed at exit).
  out=$(CCS_OPEN_PLAN="$OPEN_TMP/plan" CCS_OPEN_TTY="$tty" CCS_OPEN_TMPDIR="$MACHINE_TMP_BASE" \
    TMPDIR="$OPEN_TMP" TSX_DISABLE_CACHE=1 "${TSX_RUN[@]}" "${CCS_MACHINE}" open "$@" 2>"$OPEN_TMP/err" </dev/null) || rc=$?
  trap - INT
  load_error=$(stage2_load_error "$OPEN_TMP/err")
  if [[ -n "$out" || -s "$OPEN_TMP/plan" ]] || { (( ! MACHINE_JSON )) && [[ -z "$load_error" ]] && (( ! got_int )); }; then
    [[ -z "$out" ]] || printf '%s\n' "$out"
    cat "$OPEN_TMP/err" >&2
    (( rc == 0 )) && [[ -s "$OPEN_TMP/plan" ]] || exit "$rc"
  else
    (( got_int )) && machine_fail open "$MACHINE_JSON" interrupted 130 interrupted
    [[ "$load_error" == invalid_package_config ]] &&
      machine_fail open "$MACHINE_JSON" failed 1 invalid_package_config
    machine_fail open "$MACHINE_JSON" failed 1 internal_error "" "${load_error:-no answer from the module}"
  fi

  # --here: the plan, checked again before anything runs.
  local fields=() f
  while IFS= read -r -d '' f; do fields+=("$f"); done < "$OPEN_TMP/plan"
  (( ${#fields[@]} == 4 )) || machine_fail open "$MACHINE_JSON" failed 1 internal_error
  local kind=${fields[0]} key=${fields[1]} cwd=${fields[2]} cmd=${fields[3]}
  case "$kind" in
    resume) [[ "$key" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] ||
              machine_fail open "$MACHINE_JSON" rejected 6 invalid_uuid ;;
    new) command_is_safe "$key" || machine_fail open "$MACHINE_JSON" rejected 6 unsafe_characters ;;
    *) machine_fail open "$MACHINE_JSON" failed 1 internal_error ;;
  esac
  command_is_safe "$cmd" || machine_fail open "$MACHINE_JSON" rejected 6 command_unsafe
  if [[ ( "$cwd" != "$HOME" && "$cwd" != "$HOME"/* ) || "/${cwd}/" == */../* ]]; then
    machine_fail open "$MACHINE_JSON" rejected 6 path_outside_home
  fi
  cd "$cwd" 2>/dev/null || machine_fail open "$MACHINE_JSON" rejected 6 path_not_found
  rm -rf "$OPEN_TMP"
  trap - EXIT
  # The exit code from here on is the launched command's (outside the table).
  run_launch_command "$kind" "$key" "$cmd" ${pass[@]+"${pass[@]}"}
  exit 0
}

case "${1:-}" in
  doctor) shift; run_doctor "$@" ;;
  open) shift; run_open "$@" ;;
  list|sessions|repo|config) run_machine "$@" ;;
esac

# ── Clipboard helper (cross-platform) ────────────────────────────────────────
clipboard_cmd() {
  if command -v pbcopy &>/dev/null; then
    echo "pbcopy"
  elif command -v xclip &>/dev/null; then
    echo "xclip -selection clipboard"
  elif command -v xsel &>/dev/null; then
    echo "xsel --clipboard --input"
  elif command -v wl-copy &>/dev/null; then
    echo "wl-copy"
  else
    echo ""
  fi
}
CLIP_CMD=$(clipboard_cmd)

# ── Dependency check ─────────────────────────────────────────────────────────
check_deps() {
  local missing=()
  command -v fzf &>/dev/null   || missing+=("fzf")
  # tsx: a resolved package-local binary counts; only require a PATH tsx
  # when no local one was found.
  if [[ "$TSX" == "tsx" ]]; then
    command -v tsx &>/dev/null || missing+=("tsx (npm install -g tsx)")
  fi
  command -v node &>/dev/null  || missing+=("node")
  command -v claude &>/dev/null || missing+=("claude (Claude Code CLI)")

  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "❌ Missing dependencies:" >&2
    for dep in "${missing[@]}"; do
      echo "   - $dep" >&2
    done
    echo "" >&2
    echo "Install with:" >&2
    echo "  brew install fzf       # or: apt install fzf" >&2
    echo "  npm install -g tsx" >&2
    exit 1
  fi
}

# ── Help / version ───────────────────────────────────────────────────────────
print_help() {
  cat <<HELP
ccs v${VERSION} - Claude Code Station (fzf-powered launcher)

Usage:
  ccs                 Mixed list: NEW repos + RESUME sessions
  ccs .               Sessions whose cwd is (under) current dir
  ccs --new           Only NEW repo entries
  ccs --resume        Only past sessions
  ccs --refresh       Force pre-scan before showing list
  ccs --no-scan       Skip implicit pre-scan (use stale DB)
  ccs --ui=simple     Friendlier full-screen look (Japanese text, fzf 0.61+);
                      --ui=classic forces the default look
  ccs init            Create ~/.config/ccs/repos.yml from the template
  ccs init --auto-discover [--depth N]
                      Scan \$HOME for git repos (default depth 5) and pick
                      which to add to repos.yml via fzf multi-select
  ccs [options]       Unknown options pass through to launched command

For scripts and tools (no fzf, no questions, no network; --json prints one
JSON answer on stdout, and the exit code says what happened):
  ccs doctor [--json] Does ccs work here? Exit 0 works, 1 does not,
                      2 bad arguments, 3 could not tell
  ccs list --json [--with-paths]
                      repos.yml entries after ccs's checks (paths only
                      with --with-paths)
  ccs sessions --json [--project NAME] [--limit N] [--with-titles] [--no-scan]
                      Past conversations per project, newest first
                      (titles only with --with-titles)
  ccs repo add PATH [--name NAME] [--description TEXT] [--json]
  ccs repo remove NAME [--json]
                      Add a folder under \$HOME to repos.yml, or take an
                      entry out (the folder is never touched)
  ccs config get [--json]
  ccs config set [--repo NAME] KEY VALUE [--json]
                      KEY is defaults.ui, defaults.terminal,
                      defaults.update_check, or label / description
                      of the entry named by --repo
  ccs open (--repo NAME | --session UUID) [--here | --new-window]
                      Start Claude Code without the list: in this terminal
                      (--here, the default), or in a new window of
                      defaults.terminal (--new-window, macOS)
  Exit codes: 0 ok, 1 failed, 2 bad arguments, 3 could not tell,
  4 missing prerequisite, 5 not found, 6 refused, 7 partly done,
  130 interrupted. doctor, list, sessions, repo, config and open are
  commands only as the first argument; \`ccs --new doctor\` still passes
  doctor on.

Controls:
  Enter               Launch (or resume) selected entry; does nothing on a
                      group header (an entry with launch: false)
  Ctrl-Y              Copy the effective shell command to clipboard
  Ctrl-I              Copy session UUID (resume) or repo path (new/group)
  Ctrl-R              Refresh DB and reload list
  Ctrl-D              Delete session (resume rows only)
  Esc / Ctrl-C        Cancel

Environment:
  CCS_CMD             Fallback launch command for repos with no explicit
                      command. Per-repo command in repos.yml always wins.
                      Example: export CCS_CMD="opr claude"
  CCR_CMD             Deprecated — still honored with a warning if CCS_CMD unset
  CCS_UI              simple | classic — overrides repos.yml defaults.ui
                      (the --ui= flag wins over both)
  CCS_NO_UPDATE_CHECK Any non-empty value stops the update check and its notice
                      (no network request, the cache is not read); so does
                      defaults.update_check: false in repos.yml
  CCS_UPDATE_REGISTRY Registry to ask instead of https://registry.npmjs.org

Examples:
  ccs                                     # Full launcher
  ccs .                                   # Resume current-dir session
  ccs --new                               # Pick a repo to launch fresh
  ccs --refresh                           # Force DB rebuild
  ccs --dangerously-skip-permissions      # Pass-through flag to claude

Config: ~/.config/ccs/repos.yml
Cache:  ~/.cache/ccs/state.db, ~/.cache/ccs/update-check

${COPYRIGHT} MIT License.
HELP
}

# ── init subcommand ──────────────────────────────────────────────────────────
# `ccs init` scaffolds the config; `ccs init --auto-discover [--depth N]`
# scans $HOME for git repos and appends fzf-selected ones to repos.yml.
# Handled before the launcher arg loop — init never opens the main list.
if [[ "${1:-}" == "init" ]]; then
  shift
  AUTO=0
  INIT_ARGS=()
  for a in "$@"; do
    case "$a" in
      --auto-discover) AUTO=1 ;;
      *) INIT_ARGS+=("$a") ;;
    esac
  done

  if [[ "$TSX" == "tsx" ]] && ! command -v tsx &>/dev/null; then
    echo "❌ tsx not found (npm install -g tsx)" >&2
    exit 1
  fi

  if (( ! AUTO )); then
    "${TSX_RUN[@]}" "${CCS_INIT}" scaffold
    exit $?
  fi

  check_deps
  echo "🔍 Scanning \$HOME for git repositories..." >&2
  CANDIDATES="$("${TSX_RUN[@]}" "${CCS_INIT}" discover ${INIT_ARGS[@]+"${INIT_ARGS[@]}"})" || exit 1
  if [[ -z "$CANDIDATES" ]]; then
    echo "No new git repositories found (everything within depth is already registered)." >&2
    exit 0
  fi
  SELECTED=$(printf '%s\n' "$CANDIDATES" | fzf \
    --multi \
    --delimiter=$'\t' \
    --header=$'TAB: toggle | Enter: add selected to repos.yml | Esc: cancel' \
    --prompt='ccs init> ' \
    --height='80%' \
    --layout=reverse \
    --border \
    --tabstop=4 \
  ) || exit 0
  [[ -z "$SELECTED" ]] && exit 0
  printf '%s\n' "$SELECTED" | "${TSX_RUN[@]}" "${CCS_INIT}" append || exit 1
  # Index the new repos right away so the next `ccs` shows them with stats.
  "${TSX_RUN[@]}" "${CCS_SCAN}" --force --quiet || {
    echo "[ccs] scan failed — run \`ccs --refresh\` to index the new repos" >&2
  }
  exit 0
fi

# ── Argument parsing ─────────────────────────────────────────────────────────
LIST_FLAGS=()
PASS_ARGS=()
DO_REFRESH=0
NO_SCAN=0
UI_FLAG=""

for arg in "$@"; do
  case "$arg" in
    .)            LIST_FLAGS+=("--current-only") ;;
    --new)        LIST_FLAGS+=("--repos-only") ;;
    --resume)     LIST_FLAGS+=("--sessions-only") ;;
    --refresh)    DO_REFRESH=1 ;;
    --no-scan)    NO_SCAN=1 ;;
    --ui=*)
      UI_FLAG="${arg#--ui=}"
      if [[ "$UI_FLAG" != "simple" && "$UI_FLAG" != "classic" ]]; then
        echo "❌ --ui must be simple or classic (got: ${UI_FLAG})" >&2
        exit 2
      fi
      ;;
    --help|-h)    print_help; exit 0 ;;
    --version|-v) echo "ccs v${VERSION}"; exit 0 ;;
    *)            PASS_ARGS+=("$arg") ;;
  esac
done

check_deps

# ── fzf version helpers ──────────────────────────────────────────────────────
# fzf_at_least MAJOR MINOR — true when the installed fzf is that version or
# newer. Unparseable / missing version → false (callers fall back safely).
fzf_at_least() {
  local v
  v=$(fzf --version 2>/dev/null) || return 1
  [[ "$v" =~ ^([0-9]+)\.([0-9]+) ]] || return 1
  local maj=$((10#${BASH_REMATCH[1]})) min=$((10#${BASH_REMATCH[2]}))
  (( maj > $1 || (maj == $1 && min >= $2) ))
}

# ── UI mode (classic | simple) ───────────────────────────────────────────────
# Priority: --ui= flag > CCS_UI env > repos.yml defaults.ui > classic. The
# repos.yml value arrives on the pre-scan's stdout (`ui=<mode>`, --print-ui),
# so the default launch costs no extra process; only when no scan ran (or it
# failed) is it read back from the cache the last scan wrote.
UI_REQ="${UI_FLAG}"
if [[ -z "$UI_REQ" && -n "${CCS_UI:-}" ]]; then
  case "${CCS_UI}" in
    simple|classic) UI_REQ="${CCS_UI}" ;;
    *) echo "[ccs] CCS_UI must be simple or classic (got: ${CCS_UI}) — ignored" >&2 ;;
  esac
fi

# ── Pre-scan ─────────────────────────────────────────────────────────────────
# The scan's stderr is held until the look is known: the classic look prints
# it exactly as before (then the same "continuing with stale DB" line); the
# simple look keeps it for after the picker closes, where it can be read.
UI_CFG=""
UPDATE_CHECK_CFG="" # off = repos.yml defaults.update_check: false
SCAN_RAN=0
SCAN_FAILED=0
# The trap first, so a second mktemp that fails does not leave the first file.
SCAN_ERR_FILE="" LIST_ERR_FILE=""
trap 'rm -f ${SCAN_ERR_FILE:+"$SCAN_ERR_FILE"} ${LIST_ERR_FILE:+"$LIST_ERR_FILE"}' EXIT
SCAN_ERR_FILE=$(mktemp "${TMPDIR:-/tmp}/ccs-scan-err.XXXXXX")
LIST_ERR_FILE=$(mktemp "${TMPDIR:-/tmp}/ccs-list-err.XXXXXX")
if (( DO_REFRESH || ! NO_SCAN )); then
  SCAN_RAN=1
  SCAN_ARGS=(--quiet --print-settings)
  (( DO_REFRESH )) && SCAN_ARGS=(--force "${SCAN_ARGS[@]}")
  if SCAN_OUT=$("${TSX_RUN[@]}" "${CCS_SCAN}" "${SCAN_ARGS[@]}" 2>"$SCAN_ERR_FILE"); then
    case "$SCAN_OUT" in
      *ui=simple*)  UI_CFG="simple" ;;
      *ui=classic*) UI_CFG="classic" ;;
    esac
    case "$SCAN_OUT" in
      *update_check=off*) UPDATE_CHECK_CFG="off" ;;
      *update_check=on*)  UPDATE_CHECK_CFG="on" ;;
    esac
  else
    SCAN_FAILED=1
  fi
fi

# No scan this launch (--no-scan, or it failed): the settings the last scan
# stored, in one read — only when one of them is still needed.
UI="${UI_REQ:-${UI_CFG}}"
if [[ -z "$UI" || ( -z "$UPDATE_CHECK_CFG" && -z "${CCS_NO_UPDATE_CHECK:-}" ) ]]; then
  SETTINGS_OUT=$("${TSX_RUN[@]}" "${CCS_LIST}" --print-settings 2>/dev/null) || SETTINGS_OUT=""
  if [[ -z "$UI" ]]; then
    case "$SETTINGS_OUT" in
      *ui=simple*) UI="simple" ;;
      *) UI="classic" ;;
    esac
  fi
  case "$SETTINGS_OUT" in
    *update_check=off*) UPDATE_CHECK_CFG="off" ;;
  esac
fi
[[ "$UI" == "simple" ]] || UI="classic"

# The simple look's flags (--style, the four labels, --ghost) need fzf 0.61+.
# On an older fzf the classic look opens instead, with one line saying why.
if [[ "$UI" == "simple" ]] && ! fzf_at_least 0 61; then
  FZF_V=$(fzf --version 2>/dev/null | awk '{print $1}')
  echo "[ccs] やさしい見た目（ui: simple）には fzf 0.61 以上が要ります（いまの fzf: ${FZF_V:-不明}）。ふつうの見た目で開きます。fzf を新しくするには: brew upgrade fzf" >&2
  UI="classic"
fi

# Node takes a .ts module's type from the nearest package.json above it, and
# refuses to load any module when that file cannot be parsed. bin/package.json
# keeps the search inside the package, but a copy install (install.sh copies
# only ccs*) sits under someone else's directories. No rescan or refresh can
# get past that, so instead of an empty list and exit 0, ccs stops here with
# one line naming the file. The reason word (invalid_package_config) is the
# same in both looks, for scripts and the self-check to match on.
# text_is_plain TEXT — true when TEXT holds nothing a terminal acts on: no C0
# control or DEL, no C1 control (UTF-8 C2 80–9F), no mark that reorders text
# (U+061C, U+200E–F, U+202A–E, U+2066–9). Byte-wise (LC_ALL=C), so it is the
# same on every locale and bash 3.2.
text_is_plain() {
  local LC_ALL=C
  [[ ! "$1" =~ [[:cntrl:]] ]] || return 1
  case "$1" in
    *$'\xc2'[$'\x80'-$'\x9f']* | *$'\xd8\x9c'* | *$'\xe2\x80'[$'\x8e'$'\x8f'$'\xaa'-$'\xae']* | *$'\xe2\x81'[$'\xa6'-$'\xa9']*)
      return 1 ;;
  esac
}

stop_on_package_config() { # stop_on_package_config STDERR_FILE
  local line bad="" found=0
  local re='Invalid package config (.*package\.json)'
  [[ -s "$1" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ $re ]]; then
      found=1 bad="${BASH_REMATCH[1]}"
      break
    fi
    [[ "$line" == *ERR_INVALID_PACKAGE_CONFIG* ]] && found=1
  done < "$1"
  (( found )) || return 0
  # Only a package.json at or above ccs's own folder can stop the modules:
  # they start from that folder (ccs-tsx.sh), never from the user's. The
  # same words in another failure's message do not stop the list.
  if [[ -n "$bad" && "$bad" == */package.json && "${SCRIPT_DIR}/" != "${bad%/package.json}/"* ]]; then
    return 0
  fi
  # The path comes from Node's message, i.e. from folder names: one a terminal
  # would act on (ESC, C1, text-direction marks) is not printed.
  text_is_plain "$bad" || bad=""
  if [[ "$UI" == "simple" ]]; then
    echo "[ccs] 一覧を開けません（invalid_package_config）: ${bad:-ccs より上のフォルダの package.json} が壊れていて、Node が ccs の部品を読めません。このファイルを直すか消してから、もう一度 ccs と打ってください。" >&2
  else
    echo "[ccs] cannot open the list (invalid_package_config): Node cannot parse ${bad:-a package.json above ccs}, so it will not load ccs's modules. Fix or remove that file, then run ccs again." >&2
  fi
  exit 1
}
(( SCAN_FAILED )) && stop_on_package_config "$SCAN_ERR_FILE"

# better-sqlite3 ships prebuilt modules for the common platforms; anywhere else
# one has to be built from source, which ccs does not do or test.
native_module_missing() {
  grep -Eq 'Cannot find module .*better-sqlite3' "$SCAN_ERR_FILE" 2>/dev/null
}
print_native_module_hint() {
  native_module_missing || return 0
  if [[ "$UI" == "simple" ]]; then
    echo "[ccs] この環境（$(uname -s)-$(uname -m)）向けの部品（better-sqlite3）が入っていません。ソースから作る必要があります。" >&2
  else
    echo "[ccs] better-sqlite3 has no prebuilt module for this platform ($(uname -s)-$(uname -m)); it has to be built from source." >&2
  fi
}

if [[ "$UI" == "classic" ]]; then
  cat "$SCAN_ERR_FILE" >&2
  print_native_module_hint
  if (( SCAN_FAILED )); then
    if (( DO_REFRESH )); then
      echo "[ccs] refresh failed, continuing with stale DB" >&2
    else
      echo "[ccs] scan failed, continuing with stale DB" >&2
    fi
  fi
fi

# simple: what to say about the scan once the picker has closed (empty when
# the scan was quiet). Printed by print_scan_notes.
print_scan_notes() {
  [[ "$UI" == "simple" ]] || return 0
  if native_module_missing; then
    print_native_module_hint
  elif (( SCAN_FAILED )); then
    echo "[ccs] 設定ファイル（~/.config/ccs/repos.yml）を読めなかったので、前の一覧を出しました。下の行を直してから、もう一度 ccs と打ってください。" >&2
    sed 's/^/    /' "$SCAN_ERR_FILE" >&2
  elif [[ -s "$SCAN_ERR_FILE" ]]; then
    echo "[ccs] 設定ファイルについてのお知らせです（このままでも使えます）。" >&2
    sed 's/^/    /' "$SCAN_ERR_FILE" >&2
  fi
}

# ── fzf bindings ─────────────────────────────────────────────────────────────
# Row layout (tab-separated columns):
#   1: LABEL  2: DESCRIPTION  3: BADGES  4: KIND:KEY  5: CWD  6: COMMAND

LIST_ARGS_STR=""
for f in "${LIST_FLAGS[@]+"${LIST_FLAGS[@]}"}"; do
  LIST_ARGS_STR+=" ${f}"
done
if [[ "$UI" == "simple" ]]; then
  LIST_FLAGS+=("--ui=simple")
  LIST_ARGS_STR+=" --ui=simple"
fi

# Header flashes and notices, per look (simple = Japanese, plain words).
if [[ "$UI" == "simple" ]]; then
  MSG_COPIED_CMD='📋 開くためのコマンドをコピーしました'
  MSG_COPIED_ID='📋 会話の番号（またはフォルダの場所）をコピーしました'
  MSG_NO_REPO_DELETE='[ccs] プロジェクトは一覧から消せません。外すときは ~/.config/ccs/repos.yml を直してください（何かキーを押すと戻ります）'
else
  MSG_COPIED_CMD='📋 Copied command to clipboard — ⏎: launch | ^Y: copy again'
  MSG_COPIED_ID='📋 Copied ID/path to clipboard — ⏎: launch | ^I: copy again'
  MSG_NO_REPO_DELETE='[ccs] Repos can only be removed by editing ~/.config/ccs/repos.yml (press any key)'
fi

CLIP_BINDS=()
if [[ -n "$CLIP_CMD" ]]; then
  # ctrl-y: build "cd CWD && COMMAND [--resume UUID]" depending on kind ({4})
  # Keep fzf open (no +abort) and briefly flash a header confirming the copy.
  # cwd/uuid are %q-quoted: the clipboard line gets pasted into a live shell,
  # so a tainted cwd must arrive as an inert literal, never as syntax (audit
  # H-1 defense-in-depth — intake sanitization in ccs-scan is the first gate).
  # group:* (display-only header) and separator rows have no command, so
  # nothing is built or copied for them.
  CLIP_BINDS+=(--bind "ctrl-y:execute-silent(
    kk={4}; cwd={5}; cmd={6};
    case \"\$kk\" in
      resume:*) uuid=\${kk#resume:}; printf 'cd %q && %s --resume %q' \"\$cwd\" \"\$cmd\" \"\$uuid\" | ${CLIP_CMD} ;;
      new:*)    printf 'cd %q && %s' \"\$cwd\" \"\$cmd\" | ${CLIP_CMD} ;;
    esac
  )+change-header(${MSG_COPIED_CMD})")
  # ctrl-i: copy UUID (resume) or repo path (new, group header)
  CLIP_BINDS+=(--bind "ctrl-i:execute-silent(
    kk={4};
    case \"\$kk\" in
      resume:*)      printf '%s' \"\${kk#resume:}\" | ${CLIP_CMD} ;;
      new:*|group:*) printf '%s' {5} | ${CLIP_CMD} ;;
    esac
  )+change-header(${MSG_COPIED_ID})")
fi

# ctrl-d: delete session (resume only). Repo (new) rows and group headers
# cannot be deleted from ccs — repos.yml is the source of truth; edit it
# directly to remove.
DELETE_BIND=(--bind "ctrl-d:execute(
  kk={4};
  case \"\$kk\" in
    resume:*)      bash '${CCS_DELETE}' \"\${kk#resume:}\" ;;
    new:*|group:*) echo '${MSG_NO_REPO_DELETE}'; read -r -n1 _ ;;
  esac
)+reload(bash '${CCS_TSX_SH}' '${CCS_LIST}'${LIST_ARGS_STR})")

# enter / double-click on a group header (KIND=group, a repos.yml entry with
# `launch: false`) keep the picker open instead of accepting the row. That
# needs fzf's transform action (0.45+); on an older fzf the row is accepted
# as usual and the post-selection check below exits quietly, like the
# separator row. The `transform:` form takes the rest of the string as its
# argument, so the `)` of the case patterns cannot end it early. fzf runs the
# command with $SHELL -c; the test itself goes through `bash -c` so a
# non-POSIX login shell (fish) cannot break Enter on every row.
GROUP_BINDS=()
if [[ "$UI" == "simple" ]]; then
  # simple: Enter on a heading, a group header or an empty result says why
  # nothing opened (a one-line header flash) instead of doing nothing; any
  # cursor move puts the usual guide line back (focus). fzf >= 0.61 here.
  MSG_ON_GROUP='  ここは見出しです。下の行をえらんでください'
  MSG_ON_SEPARATOR='  ここは区切りの行です。上か下の行をえらんでください'
  MSG_NO_MATCH='  見つかりません。delete キーで文字を消してください'
  for key in enter double-click; do
    GROUP_BINDS+=(--bind "${key}:transform:bash -c 'case \$1 in group:*) echo \"change-header(${MSG_ON_GROUP})\" ;; separator:*) echo \"change-header(${MSG_ON_SEPARATOR})\" ;; \"\") echo \"change-header(${MSG_NO_MATCH})\" ;; *) echo accept ;; esac' _ {4}")
  done
elif fzf_at_least 0 45; then
  for key in enter double-click; do
    GROUP_BINDS+=(--bind "${key}:transform:bash -c 'case \$1 in group:*) echo ignore ;; *) echo accept ;; esac' _ {4}")
  done
fi

# ctrl-r: force refresh
REFRESH_BIND=(--bind "ctrl-r:execute(bash '${CCS_TSX_SH}' '${CCS_SCAN}' --force --quiet)+reload(bash '${CCS_TSX_SH}' '${CCS_LIST}'${LIST_ARGS_STR})")

# ── Header (adaptive to terminal width) ──────────────────────────────────────
# Note: ^D deletes SESSIONS only; repos are managed via ~/.config/ccs/repos.yml
# Asks the terminal itself: `tput cols 2>/dev/null` inside $() sees no terminal
# on stdout or stderr and answers 80 at any width. COLUMNS wins when exported.
terminal_cols() {
  local size=""
  if [[ "${COLUMNS:-}" =~ ^[1-9][0-9]*$ ]]; then
    echo "$COLUMNS"
    return 0
  fi
  size=$(stty size 2>/dev/null </dev/tty) || size=""
  size="${size##* }"
  if [[ "$size" =~ ^[1-9][0-9]*$ ]]; then echo "$size"; else echo 80; fi
}
COLS=$(terminal_cols)
if (( COLS >= 80 )); then
  HEADER=$'Enter: launch | ^Y: copy cmd | ^I: copy ID/path | ^R: refresh\n^D: del session (edit repos.yml to remove a repo) | Esc: cancel'
else
  HEADER=$'⏎launch ^Y:cmd ^I:ID ^R:refresh\n^D:del[resume] Esc:quit'
fi

# ── Version and copyright (fzf border label) ─────────────────────────────────
# The frame already exists in both looks, so the label costs no list row, and
# change-header cannot replace it. fzf draws a label that is too long over the
# frame's corners, so take the longest form that fits: the title goes first, then
# the word Copyright, and the version stays. Computed once at start, like the
# header above. Separators are plain spaces: `·` and `→` are East Asian Ambiguous.
#   label_fits: 2 for the corner and first dash on the left, 2 on the right so
#   the label never touches the closing corner.
label_fits() { (( COLS >= $1 + 4 )); }
VERSION_TAG="ccs v${VERSION}"
COPYRIGHT_SHORT='© INDIGO GROUP LLC.'
TITLE='Claude Code をはじめる'
TAG_W=${#VERSION_TAG} COPYRIGHT_W=29 COPYRIGHT_SHORT_W=19 TITLE_W=22
if [[ "$UI" == "simple" ]]; then
  PAD='  '
else
  PAD=' '
fi
PAD_W=$(( ${#PAD} * 2 ))
if [[ "$UI" == "simple" ]] && label_fits $(( PAD_W + TITLE_W + 2 + TAG_W + 2 + COPYRIGHT_W )); then
  BORDER_LABEL="${PAD}${TITLE}  ${VERSION_TAG}  ${COPYRIGHT}${PAD}"
elif label_fits $(( PAD_W + TAG_W + 2 + COPYRIGHT_W )); then
  BORDER_LABEL="${PAD}${VERSION_TAG}  ${COPYRIGHT}${PAD}"
elif label_fits $(( PAD_W + TAG_W + 2 + COPYRIGHT_SHORT_W )); then
  BORDER_LABEL="${PAD}${VERSION_TAG}  ${COPYRIGHT_SHORT}${PAD}"
else
  BORDER_LABEL="${PAD}${VERSION_TAG}${PAD}"
fi

# ── Update notice ────────────────────────────────────────────────────────────
# Startup only reads the cache (no process but `date`). When the cache is a day
# old, ccs-update-check.ts refreshes it in the background for the NEXT launch:
# never waited for, silent, with its own time limit. Only a plain X.Y.Z on both
# sides compares, so a prerelease or a dev checkout gets no notice, and the
# cache's text is safe to put in an fzf option. Set UPDATE_LATEST when the npm
# latest is newer than this version.
UPDATE_LATEST=""
UPDATE_INTERVAL=86400
version_is_newer() { # version_is_newer CANDIDATE CURRENT (both X.Y.Z)
  local a b ai bi i
  IFS=. read -r -a a <<< "$1"
  IFS=. read -r -a b <<< "$2"
  for i in 0 1 2; do
    ai=$((10#${a[$i]})) bi=$((10#${b[$i]}))
    (( ai > bi )) && return 0
    (( ai < bi )) && return 1
  done
  return 1
}
check_for_update() {
  [[ -z "${CCS_NO_UPDATE_CHECK:-}" ]] || return 0
  # repos.yml defaults.update_check: false — the same stop (no network, the
  # cache is not read, no notice).
  [[ "$UPDATE_CHECK_CFG" != "off" ]] || return 0
  local plain='^[0-9]{1,9}\.[0-9]{1,9}\.[0-9]{1,9}$'
  [[ "$VERSION" =~ $plain ]] || return 0

  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/ccs/update-check"
  local key value latest="" checked=0
  if [[ -f "$cache" && -r "$cache" ]]; then
    while IFS='=' read -r key value || [[ -n "$key" ]]; do
      case "$key" in
        latest)  latest="$value" ;;
        checked) checked="$value" ;;
      esac
    done < "$cache"
  fi
  if [[ "$latest" =~ $plain ]] && version_is_newer "$latest" "$VERSION"; then
    UPDATE_LATEST="$latest"
  fi

  # stdout not a terminal = a script or a test, not someone at the picker.
  [[ -t 1 ]] || return 0
  [[ "$checked" =~ ^[0-9]{1,12}$ ]] || checked=0
  local age=$(( $(date +%s) - 10#$checked ))
  if (( age >= UPDATE_INTERVAL || age < 0 )); then
    ( "${TSX_RUN[@]}" "${CCS_UPDATE}" "${CCS_PACKAGE}" </dev/null >/dev/null 2>&1 & )
  fi
  return 0
}
check_for_update || true

# simple: the frame says a new version is out; how to get it is printed once the
# picker has closed, where it can be read and copied.
print_update_note() {
  [[ -n "$UPDATE_LATEST" ]] || return 0
  echo "[ccs] 新しい ccs v${UPDATE_LATEST} が出ています（いまは v${VERSION}）。上げるには: ${CCS_INSTALL_CMD}" >&2
}

# ── Launch fzf (simple) ──────────────────────────────────────────────────────
# Same rows, same bindings and the same post-pick path as the classic look;
# only the frame, the words and where the badges live differ (the list shows
# column 1 only — ccs-list puts the whole simple line there).
#   --no-sort      the list keeps its order while filtering: typing a group's
#                  name shows the group, then its projects, then their
#                  conversations — a score sort put the conversations first
#   --header-border=none / preview below under 50 columns
#                  keep 8 list rows visible on an 80x24 terminal (5 with a
#                  boxed guide line and a 45% preview)
#   --no-hscroll   a match far right (the group's name after a description)
#                  must not scroll the row and hide the project's own name
#   change:first   fzf keeps the cursor's row number across a query change;
#                  every edit goes back to the top match instead
#   result:…down   the cursor never rests on a heading row after the list
#                  (re)loads or a filter finishes
#   zero/result    with no match fzf fires zero, result, focus, in that order,
#                  and focus would put the guide line back over the no-match
#                  message. So zero unbinds focus and result rebinds it once
#                  there are rows; the result binding already runs bash, so a
#                  cursor move still costs no process
if [[ "$UI" == "simple" ]]; then
  SIMPLE_HEADER='  Enter: ひらく   ↑↓ かマウス: えらぶ   Esc: やめる'
  LIST_LABEL='  えらぶ  '
  if (( SCAN_FAILED )); then
    LIST_LABEL='  えらぶ  ⚠️ 設定ファイルを読めませんでした（Esc でやめると理由が出ます）  '
  elif [[ -n "$UPDATE_LATEST" ]] && (( COLS >= 44 )); then
    LIST_LABEL="  えらぶ  ccs v${UPDATE_LATEST} が出ています  "
  fi
  LIST_FAILED=0
  ROWS=$("${TSX_RUN[@]}" "${CCS_LIST}" "${LIST_FLAGS[@]}" 2>"$LIST_ERR_FILE") || LIST_FAILED=1
  (( LIST_FAILED )) && stop_on_package_config "$LIST_ERR_FILE"
  # A bash match, not `printf | grep -q`: grep -q exits at the first hit,
  # printf then dies of SIGPIPE, and pipefail turns that into "no rows".
  if [[ "$ROWS" != *$'\t'new:* && "$ROWS" != *$'\t'resume:* ]]; then
    print_scan_notes
    if (( LIST_FAILED )); then
      echo "まだ一覧の準備ができていません。ccs --refresh と打ってください。"
      exit 0
    fi
    case " ${LIST_FLAGS[*]} " in
      *" --current-only "*)
        echo "このフォルダでの前の会話は、まだありません。全部の一覧は ccs と打つと出ます。" ;;
      *" --sessions-only "*)
        echo "前の会話は、まだありません。ccs と打つと、プロジェクトをえらんで新しく始められます。" ;;
      *)
        echo "まだ一覧に出すプロジェクトがありません。"
        echo "  ・ホームのフォルダから選んで足すには: ccs init --auto-discover"
        echo "  ・自分で書くときは ~/.config/ccs/repos.yml を開いて、repos: の下にフォルダを足してください" ;;
    esac
    exit 0
  fi
  FZF_RC=0
  SELECTED=$(printf '%s\n' "$ROWS" | fzf \
    --ansi \
    --delimiter=$'\t' \
    --with-nth=1 \
    --no-sort --no-hscroll \
    --style=full:rounded --border=rounded \
    --border-label="${BORDER_LABEL}" --border-label-pos=3 \
    --list-label="${LIST_LABEL}" --input-label='  さがす  ' --preview-label='  中身  ' \
    --header="${SIMPLE_HEADER}" --header-border=none \
    --ghost='ここに文字を打つと、しぼりこめます' \
    --prompt='🔎 ' --pointer='▶' --highlight-line \
    --info=inline-right --layout=reverse --height=100% \
    --color='label:blue:bold,border:gray,header:gray,pointer:blue,hl:red,hl+:red' \
    --preview="bash '${CCS_TSX_SH}' '${CCS_PREVIEW}' {4} {5} --ui=simple" \
    --preview-window='right,50%,wrap,<50(down,40%,wrap)' \
    "${CLIP_BINDS[@]+"${CLIP_BINDS[@]}"}" \
    "${DELETE_BIND[@]}" \
    "${REFRESH_BIND[@]}" \
    "${GROUP_BINDS[@]}" \
    --bind "focus:change-header(${SIMPLE_HEADER})" \
    --bind "zero:unbind(focus)+change-header(${MSG_NO_MATCH})" \
    --bind "change:first" \
    --bind "result:transform:bash -c 'case \$1 in separator:*) echo \"rebind(focus)+down\" ;; ?*) echo \"rebind(focus)\" ;; esac' _ {4}" \
  ) || FZF_RC=$?
  print_scan_notes
  print_update_note
  if (( FZF_RC != 0 )) || [[ -z "$SELECTED" ]]; then
    if (( FZF_RC == 2 )); then
      echo "[ccs] 一覧をうまく開けませんでした。今の見た目で開くには: ccs --ui=classic" >&2
    else
      echo "やめました。もう一度ひらくときは ccs と打ってください。"
    fi
    exit 0
  fi
fi

# ── Launch fzf ───────────────────────────────────────────────────────────────
if [[ "$UI" == "classic" ]]; then
# The picker opens below this line (--height), and the header beside the preview
# is too narrow for the command, so the notice goes above the frame. It costs no
# list row and stays in the scrollback after the picker closes.
if [[ -n "$UPDATE_LATEST" ]]; then
  echo "[ccs] Update v${VERSION} -> v${UPDATE_LATEST}: ${CCS_INSTALL_CMD}" >&2
fi
# The rows are read before fzf starts, so a list that cannot load at all stops
# with its reason instead of opening empty. Any other failure prints what the
# list said and opens with the rows it gave (each one already checked by
# ccs-list, and checked again below before anything runs), so a row picked
# from them launches. Until 0.4.x the list was piped into fzf and such a
# failure ended ccs without launching, even after a pick.
ROWS=""
if ! ROWS=$("${TSX_RUN[@]}" "${CCS_LIST}" "${LIST_FLAGS[@]+"${LIST_FLAGS[@]}"}" 2>"$LIST_ERR_FILE"); then
  stop_on_package_config "$LIST_ERR_FILE"
fi
cat "$LIST_ERR_FILE" >&2
SELECTED=$({ [[ -z "$ROWS" ]] || printf '%s\n' "$ROWS"; } | fzf \
  --ansi \
  --delimiter=$'\t' \
  --with-nth=1..3 \
  --header="${HEADER}" \
  --preview="bash '${CCS_TSX_SH}' '${CCS_PREVIEW}' {4} {5}" \
  --preview-window='right:55%:wrap' \
  "${CLIP_BINDS[@]+"${CLIP_BINDS[@]}"}" \
  "${DELETE_BIND[@]}" \
  "${REFRESH_BIND[@]}" \
  "${GROUP_BINDS[@]+"${GROUP_BINDS[@]}"}" \
  --height='80%' \
  --layout=reverse \
  --border \
  --border-label="${BORDER_LABEL}" --border-label-pos=3 \
  --prompt='ccs> ' \
  --tabstop=4 \
) || exit 0
fi

[[ -z "$SELECTED" ]] && exit 0

# ── Parse selected row ───────────────────────────────────────────────────────
# 6-col TSV from ccs-list.ts: LABEL, DESCRIPTION, BADGES, KIND:KEY, CWD, COMMAND.
# Use IFS-based read so values are never resplit by shell word-splitting
# (H6 fix). The three `_` placeholders skip columns 1-3.
# Tabs are swapped for US (\x1f) first: TAB is IFS whitespace, so a plain
# `IFS=$'\t' read` merges runs of tabs, and an empty column (a repo without a
# description, a group header's empty BADGES) shifted every later field —
# KIND_KEY came back holding the cwd. \x1f is not IFS whitespace, so empty
# fields survive, and it never occurs inside a row: every column is stripped
# of (or rejected for) control characters upstream.
IFS=$'\x1f' read -r _ _ _ KIND_KEY ROW_CWD ROW_CMD <<< "${SELECTED//$'\t'/$'\x1f'}"

if [[ -z "$KIND_KEY" ]]; then
  echo "❌ Could not parse selection" >&2
  exit 1
fi

KIND="${KIND_KEY%%:*}"
KEY="${KIND_KEY#*:}"

# Separator row is a non-actionable divider (empty ROW_CWD/ROW_CMD by design),
# and a group header (`launch: false`) is display-only (empty ROW_CMD) — it
# only gets here when the enter binding above is unavailable (fzf < 0.45).
# Short-circuit here so the downstream ROW_CMD empty-check doesn't misfire.
[[ "$KIND" == "separator" || "$KIND" == "group" ]] && exit 0

if [[ -z "$ROW_CMD" ]]; then
  echo "❌ Could not parse selection" >&2
  exit 1
fi

# Defense-in-depth copy of the policy ccs-config.ts enforces on command at load
# time. Extra columns would also land here, joined by \x1f, and be refused.
if ! command_is_safe "$ROW_CMD"; then
  echo "❌ Refusing the selected row's command (shell metacharacters/control chars)" >&2
  exit 1
fi

# ── Per-row command is authoritative ─────────────────────────────────────────
# CCS_CMD env is resolved by ccs-config.ts as a fallback for repos without
# explicit `command:` (priority: repos[].command > defaults.command > CCS_CMD > "claude").
# Do NOT override here — that would break special-command repos like Strapi.

# ── Validation ───────────────────────────────────────────────────────────────
case "$KIND" in
  resume)
    if [[ ! "$KEY" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
      echo "❌ Invalid session ID format: ${KEY}" >&2
      exit 1
    fi
    ;;
  new)
    # Reject shell metacharacters, quotes/backslash AND control chars
    # (incl. ESC — audit NEW-2). Mirrors the SHELL_METACHARS policy that
    # ccs-config.ts enforces on repo names at load time; this is the
    # defense-in-depth copy for rows coming back out of fzf.
    if [[ "$KEY" =~ [\;\&\|\<\>\$\`\"\'\\] || "$KEY" =~ [[:cntrl:]] ]]; then
      echo "❌ Invalid repo name (shell metacharacters/control chars): ${KEY}" >&2
      exit 1
    fi
    ;;
  separator|group)
    # Defensive: separator/group should already be short-circuited above.
    # Kept as a safety net in case row-parse order ever changes.
    exit 0
    ;;
  *)
    echo "❌ Unknown row kind: ${KIND}" >&2
    exit 1
    ;;
esac

# Path validation (traversal prevention). Must be $HOME itself or a child
# path ("$HOME"/*): a bare prefix match would also accept sibling dirs like
# /Users/xEVIL (audit L-1). A `..` segment could walk back out of $HOME.
if [[ ( "$ROW_CWD" != "$HOME" && "$ROW_CWD" != "$HOME"/* ) || "/${ROW_CWD}/" == */../* ]]; then
  if [[ "$UI" == "simple" ]]; then
    echo "⚠️  ホームの外のフォルダ（${ROW_CWD}）は開けないので、いまいるフォルダで開きます" >&2
  else
    echo "⚠️  cwd is outside \$HOME: ${ROW_CWD}" >&2
    echo "Launching in current directory instead." >&2
  fi
  ROW_CWD="."
fi

# Note: shell metachars in ROW_CMD are hard-rejected at config-load time by
# bin/ccs-config.ts (SHELL_METACHARS regex covers `;&|<>$`"'\` + control chars).
# The informational rm/sudo/; warning that used to live here was removed in
# Phase 6 because the metachar rejection is now the authoritative guard.

# ── cd ───────────────────────────────────────────────────────────────────────
if ! cd "$ROW_CWD" 2>/dev/null; then
  if [[ "$UI" == "simple" ]]; then
    echo "⚠️  フォルダ ${ROW_CWD} が見つからないので、いまいるフォルダ（$(pwd)）で開きます" >&2
  else
    echo "⚠️  Directory ${ROW_CWD} not found. Launching in $(pwd) instead." >&2
  fi
fi

# $PWD with $HOME shown as ~ (simple look). A function, not
# ${PWD/#$HOME/\~}: bash 3.2 — still /bin/bash on macOS — prints the backslash.
tilde_pwd() {
  case "$PWD" in
    "$HOME") printf '~' ;;
    "$HOME"/*) printf '~%s' "${PWD#"$HOME"}" ;;
    *) printf '%s' "$PWD" ;;
  esac
}

# ── Execute ──────────────────────────────────────────────────────────────────
# run_launch_command: direct invocation (NOT exec), ROW_CMD split into words
# with no wildcard expansion — the same path `ccs open --here` takes.
case "$KIND" in
  resume)
    if [[ "$UI" == "simple" ]]; then
      echo "🔄 前の会話のつづきを開きます（$(tilde_pwd)）"
    else
      echo "🔄 Resuming session ${KEY} in $(pwd)..."
    fi
    ;;
  new)
    if [[ "$UI" == "simple" ]]; then
      echo "🚀 Claude Code を開きます（$(tilde_pwd)）"
    else
      echo "🚀 Launching ${KEY} in $(pwd)..."
    fi
    ;;
esac
run_launch_command "$KIND" "$KEY" "$ROW_CMD" "${PASS_ARGS[@]+"${PASS_ARGS[@]}"}"
